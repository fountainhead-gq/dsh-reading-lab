{
  "name": "dsh-reading-lab",
  "version": "0.2.0",
  "description": "阅读实验室 — PDF/EPUB 导入、带引用的思维导图与研究笔记、卡片询问 AI、导出。",
  "type": "module",
  "license": "MIT",
  "author": "fountainhead-gq",
  "icon": "icon.svg",
  "homepage": "https://github.com/fountainhead-gq/dsh-reading-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fountainhead-gq/dsh-reading-lab.git"
  },
  "bugs": {
    "url": "https://github.com/fountainhead-gq/dsh-reading-lab/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reading",
    "epub",
    "pdf",
    "mindmap",
    "notes"
  ],
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "schema",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node scripts/build-client.mjs --check && node --check src/host/index.js && node --check src/client/index.js && node --check client.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:smoke": "node --test \"test/smoke/*.test.js\"",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:check": "node scripts/gen-fixtures.mjs --check",
    "verify": "npm run check && npm run fixtures:check && npm test",
    "build:client": "node scripts/build-client.mjs",
    "build:client:check": "node scripts/build-client.mjs --check"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
